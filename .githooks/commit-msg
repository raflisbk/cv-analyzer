#!/usr/bin/env sh

COMMIT_MSG_FILE="$1"

if [ -z "$COMMIT_MSG_FILE" ] || [ ! -f "$COMMIT_MSG_FILE" ]; then
  exit 0
fi

TMP_FILE="${COMMIT_MSG_FILE}.tmp"

grep -viE '^[^[:alnum:]]*(co-authored-by|assisted-by|generated with|powered by)' "$COMMIT_MSG_FILE" > "$TMP_FILE" || true
mv "$TMP_FILE" "$COMMIT_MSG_FILE"
