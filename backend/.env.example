# CV Analyzer Backend - Environment Variables
# Copy this file to .env and fill in your values

# App Configuration
CV_ANALYZER_APP_NAME=CV Analyzer API
CV_ANALYZER_VERSION=0.1.0
CV_ANALYZER_ENV=development

# Database Configuration
CV_ANALYZER_DB_HOST=localhost
CV_ANALYZER_DB_PORT=5432
CV_ANALYZER_DB_NAME=cv_analyzer
CV_ANALYZER_DB_USER=postgres
CV_ANALYZER_DB_PASSWORD=your_password_here

# Redis Configuration
CV_ANALYZER_REDIS_URL=redis://localhost:6379/0

# Cloudflare R2 Storage (configured in later plan)
CV_ANALYZER_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CV_ANALYZER_R2_ACCESS_KEY=your_r2_access_key
CV_ANALYZER_R2_SECRET_KEY=your_r2_secret_key
CV_ANALYZER_R2_BUCKET=cv-uploads

# Security Settings
CV_ANALYZER_MAX_FILE_SIZE=5242880
CV_ANALYZER_UPLOAD_RATE_LIMIT=5/hour

# Hugging Face Inference API (Primary provider for LLM + embeddings)
# Get your free token from: https://huggingface.co/settings/tokens
# Used for: Qwen2.5-7B-Instruct (LLM) + BGE-M3 (embeddings)
CV_ANALYZER_HF_API_KEY=your-huggingface-token-here

CV_ANALYZER_ANALYSIS_RATE_LIMIT=5/hour

# CORS Settings (comma-separated origins, use * for development)
CV_ANALYZER_CORS_ORIGINS=*

# Sentry Error Tracking (optional)
CV_ANALYZER_SENTRY_DSN=

# Logging Configuration
CV_ANALYZER_LOG_LEVEL=INFO

# Phase 3: LLM + RAG Settings
CV_ANALYZER_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
CV_ANALYZER_LLM_MAX_TOKENS=1500
CV_ANALYZER_LLM_CACHE_TTL=86400
CV_ANALYZER_RAG_TOP_K=5
CV_ANALYZER_RAG_EMBEDDING_MODEL=BAAI/bge-m3
